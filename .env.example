# BanglaEV — environment variables
# Copy this file to .env and fill in the values.
# Only VITE_* vars are exposed to the browser; the rest are server-side only.

# Site URL used for canonical/og links. Defaults to https://banglaev.com
SITE_URL=https://banglaev.com

# Optional internal API base for placeholder loaders
API_BASE=https://api.banglaev.com

# Supabase (public, non-secret config — the publishable key is safe to commit
# in .env.example, but keep your real values out of version control)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Sentry (optional — leave blank for local/preview builds)
VITE_SENTRY_DSN=
VITE_APP_RELEASE=
